# Client-safe build configuration contract. This template is not an app asset.
# Supply only the pair required by the selected entrypoint via --dart-define.
# Anonymous/publishable keys are public client credentials, not secrets.
# Never add service-role, sb_secret_, database, JWT-signing, or server secrets.

SUPABASE_DEVELOPMENT_URL=https://your-development-project.supabase.co
SUPABASE_DEVELOPMENT_ANON_KEY=your-development-anon-or-publishable-key

SUPABASE_PRODUCTION_URL=https://your-production-project.supabase.co
SUPABASE_PRODUCTION_ANON_KEY=your-production-anon-or-publishable-key
