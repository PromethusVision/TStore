# Copy this TEMPLATE to a secure directory OUTSIDE every repository checkout.
# Set ESNAFTAVAR_SIGNING_PROPERTIES to that absolute file path in the build process.
# Do not create android/key.properties. Use forward slashes for Windows paths.
# Preserve the existing owner upload keystore and its password-manager records.
storeFile=REPLACE_WITH_ABSOLUTE_EXTERNAL_KEYSTORE_PATH
storePassword=REPLACE_WITH_SECURE_STORE_PASSWORD
keyAlias=REPLACE_WITH_RELEASE_KEY_ALIAS
keyPassword=REPLACE_WITH_SECURE_KEY_PASSWORD
